# Copy to .env for local dev. See docker-compose.yml for the matching local Postgres.

# Read by docker-compose.yml, passed into the Postgres container, and used by
# db/init/01-create-app-role.sql to provision the app's non-superuser runtime
# role. Change this for anything beyond local dev.
CUE_APP_DB_PASSWORD=cue_app

# What the running app connects as — the unprivileged cue_app role, so RLS
# policies actually apply (see app/core/config.py for why this must not be
# the same role as below).
CUE_DATABASE_URL=postgresql+asyncpg://cue_app:cue_app@localhost:5432/cue

# What Alembic connects as — the schema-owning role, needed for DDL.
CUE_MIGRATION_DATABASE_URL=postgresql+asyncpg://cue:cue@localhost:5432/cue

CUE_SQL_ECHO=false

# Identity / RBAC (app/identity/) — PRD §6.14, FR-ADM. Provider-pluggable,
# same shape as the CUE_LLM_* switch below: "local" (default) is a
# self-issued HS256 token this deployment controls, for local dev and the
# test suite (tests/conftest.py's mint_token). "oidc" verifies RS256 against
# a real OIDC issuer's JWKS (Keycloak/Zitadel, per CUE-Tech-Stack.md §2.6) —
# a config change away, not a code change, once one is stood up.
CUE_AUTH_PROVIDER=local
CUE_AUTH_LOCAL_JWT_SECRET=dev-only-insecure-secret-change-me
CUE_AUTH_LOCAL_ISSUER=cue-local

# "oidc" provider only — uncomment and point at a real issuer to switch.
# CUE_AUTH_OIDC_ISSUER=https://keycloak.example/realms/cue
# CUE_AUTH_OIDC_AUDIENCE=cue-backend
# CUE_AUTH_OIDC_JWKS_URL=
