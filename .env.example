# Copy to .env for local dev. See docker-compose.yml for the matching local Postgres.

# Read by docker-compose.yml, passed into the Postgres container, and used by
# db/init/01-create-app-role.sql to provision the app's non-superuser runtime
# role. Change this for anything beyond local dev.
CUE_APP_DB_PASSWORD=cue_app

# What the running app connects as — the unprivileged cue_app role, so RLS
# policies actually apply (see app/core/config.py for why this must not be
# the same role as below).
CUE_DATABASE_URL=postgresql+asyncpg://cue_app:cue_app@localhost:5432/cue

# What Alembic connects as — the schema-owning role, needed for DDL.
CUE_MIGRATION_DATABASE_URL=postgresql+asyncpg://cue:cue@localhost:5432/cue

CUE_SQL_ECHO=false

# Comma-separated origins allowed to call this API from a browser (app/core/
# config.py's CORSMiddleware). The Next.js frontend's own local dev origin
# by default; widen per-environment, never to a bare "*" alongside the
# credentialed requests this API expects.
CUE_CORS_ORIGINS=http://localhost:3000

# Identity / RBAC (app/identity/) — PRD §6.14, FR-ADM. Provider-pluggable,
# same shape as the CUE_LLM_* switch below: "local" (default) is a
# self-issued HS256 token this deployment controls, for local dev and the
# test suite (tests/conftest.py's mint_token). "oidc" verifies RS256 against
# a real OIDC issuer's JWKS (Keycloak/Zitadel, per CUE-Tech-Stack.md §2.6) —
# a config change away, not a code change, once one is stood up. Also gates
# POST /auth/dev-login (app/api/auth.py) — that endpoint 404s outright
# unless this is "local"; it mints a real bearer token for ANY
# organisation_id/email a caller names, with no password or credential
# check of its own, so it must never be reachable once this is "oidc".
CUE_AUTH_PROVIDER=local
CUE_AUTH_LOCAL_JWT_SECRET=dev-only-insecure-secret-change-me
CUE_AUTH_LOCAL_ISSUER=cue-local

# "oidc" provider only — uncomment and point at a real issuer to switch.
# CUE_AUTH_OIDC_ISSUER=https://keycloak.example/realms/cue
# CUE_AUTH_OIDC_AUDIENCE=cue-backend
# CUE_AUTH_OIDC_JWKS_URL=

# app/llm/config.py — see CLAUDE.md's Models table. Two independently
# switchable roles (extraction / reasoning), same "ollama" (default, local,
# zero cost) vs "anthropic" shape as everything else provider-pluggable in
# this file. Only ANTHROPIC_API_KEY is a real secret here.
CUE_LLM_EXTRACTION_PROVIDER=ollama
CUE_LLM_EXTRACTION_MODEL=qwen2.5:14b
CUE_LLM_REASONING_PROVIDER=ollama
CUE_LLM_REASONING_MODEL=qwen2.5:32b
CUE_LLM_OLLAMA_BASE_URL=http://localhost:11434
# CUE_LLM_ANTHROPIC_API_KEY=

# app/foresight/config.py — the arq/Valkey worker's broker connection,
# matching docker-compose.yml's `valkey` service defaults.
CUE_ARQ_REDIS_HOST=localhost
CUE_ARQ_REDIS_PORT=6379

# ---------------------------------------------------------------------------
# NOTE (M10 / Prompt 13, NFR-SEC-03): everything below this line is real
# per-integration credentials, not local-dev-only values like the JWT
# secret above — see backend/docs/secrets-openbao-migration.md for the
# planned OpenBao migration path for this whole block once there's a real
# deployment target beyond this machine. Every var name here is drawn
# directly from this session's own real (gitignored) .env, not guessed —
# this file had drifted well behind actual usage before this refresh.
# ---------------------------------------------------------------------------

# app/documents/storage.py's MinioStorageBackend — matches docker-compose.yml's
# `minio` service defaults exactly.
CUE_STORAGE_ENDPOINT=localhost:9000
CUE_STORAGE_ACCESS_KEY=cue
CUE_STORAGE_SECRET_KEY=cue_minio_secret
CUE_STORAGE_BUCKET=cue-documents
CUE_STORAGE_SECURE=false

# app/documents/sharepoint.py's SharePointAdapter (write-back) — "noop"
# (default) logs and returns, no external call, no credentials needed.
# "graph" (real Microsoft 365, credential-blocked — Pico's Entra ID app
# registration doesn't exist yet) reads CUE_GRAPH_* below plus a site_id or
# hostname+path here. "nextcloud" is live against docker-compose's
# `nextcloud` service (CUE-PRD.md §9.3a).
CUE_SHAREPOINT_PROVIDER=noop
# CUE_SHAREPOINT_SITE_ID=
# CUE_SHAREPOINT_SITE_HOSTNAME=
# CUE_SHAREPOINT_SITE_PATH=
# CUE_SHAREPOINT_LIBRARY_FOLDER=

# "nextcloud" SharePoint-provider only — docker-compose `nextcloud` service.
# CUE_SHAREPOINT_NEXTCLOUD_BASE_URL=http://localhost:8080
# CUE_SHAREPOINT_NEXTCLOUD_USERNAME=cue
# CUE_SHAREPOINT_NEXTCLOUD_APP_PASSWORD=
# CUE_SHAREPOINT_NEXTCLOUD_REMOTE_FOLDER=CUE

# app/core/graph_auth.py's GraphSettings — shared by the "graph" SharePoint
# write-back provider above and app/capture/adapters/graph.py's
# GraphAdapter below. Credential-blocked in this environment (no Pico
# Entra ID app registration exists) — left unset deliberately.
# CUE_GRAPH_TENANT_ID=
# CUE_GRAPH_CLIENT_ID=
# CUE_GRAPH_CLIENT_SECRET=

# app/capture/config.py's CaptureSettings — one global switch for every
# channel_types code. "fixture" (default) needs no credentials at all,
# ever. "live" makes each channel's real adapter construct for real.
CUE_CAPTURE_BACKEND=fixture

# PRD §9.1 — companion-session/MDM-handset gateway, Pico-hosted.
# Credential-blocked in this environment.
# CUE_WHATSAPP_SESSION_ENDPOINT=
# CUE_WHATSAPP_API_TOKEN=

# PRD §9.2 — WeChat Work Session Archiving API. Credential-blocked in this
# environment.
# CUE_WECHAT_CORP_ID=
# CUE_WECHAT_CORP_SECRET=
# CUE_WECHAT_SESSION_ARCHIVE_SECRET=

# app/capture/adapters/mattermost.py — team_collaboration's FOSS substitute
# for Teams, live against docker-compose's `mattermost` service (bot
# account provisioned via scripts/setup_mattermost.sh).
# CUE_MATTERMOST_BASE_URL=http://localhost:8065
# CUE_MATTERMOST_BOT_TOKEN=

# app/capture/adapters/imap_smtp.py — email's FOSS substitute for Outlook.
# Point at docker-compose's `greenmail` service for a fast, no-live-inbox
# local loop (dynamic mode accepts any username/password):
# CUE_IMAP_SMTP_IMAP_HOST=localhost
# CUE_IMAP_SMTP_IMAP_PORT=3143
# CUE_IMAP_SMTP_SMTP_HOST=localhost
# CUE_IMAP_SMTP_SMTP_PORT=3025
# CUE_IMAP_SMTP_USERNAME=cue
# CUE_IMAP_SMTP_PASSWORD=cue_greenmail_secret
# CUE_IMAP_SMTP_FROM_ADDRESS=cue@cue.test
# CUE_IMAP_SMTP_IMAP_USE_SSL=false
# CUE_IMAP_SMTP_SMTP_USE_STARTTLS=false

# app/capture/adapters/nextcloud.py's NextcloudCaptureSettings — inbound
# capture (separate from the write-back block above; a project can watch a
# different folder than it writes canonical versions to).
# CUE_NEXTCLOUD_BASE_URL=http://localhost:8080
# CUE_NEXTCLOUD_USERNAME=cue
# CUE_NEXTCLOUD_APP_PASSWORD=
